# ================================================================
# Prithvi Fix — Backend Environment Configuration Example
# ================================================================

PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------
# Supabase PostgreSQL Connection (Recommended for Cloud/Production)
# ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_REGION=ap-northeast-1

# Direct / Fallback parameters
PGHOST=aws-0-[REGION].pooler.supabase.com
PGPORT=6543
PGUSER=postgres.[PROJECT_REF]
PGPASSWORD=your_database_password
PGDATABASE=postgres
PGSSLMODE=require

# ----------------------------------------------------------------
# Local PostgreSQL Alternative
# ----------------------------------------------------------------
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=sahakari_sevasetu

# ----------------------------------------------------------------
# Auth & Security
# ----------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
CORS_ALLOW_ALL=true
